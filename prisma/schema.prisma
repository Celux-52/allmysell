generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
  engineType    = "binary"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Automated trending products from TikTok/FB Ads
model AutoTrend {
  id             String   @id(map: "AutoTrend_pkey") @default(cuid())
  title          String
  slug           String   @unique(map: "AutoTrend_slug_key")
  content        String
  videoUrl       String   @map("video_url")
  thumbnailUrl   String?  @map("thumbnail_url")
  platform       String
  platformId     String   @map("platform_id")
  consensusScore Int      @default(0) @map("consensus_score")
  insights       Json?
  status         String   @default("draft")
  createdAt      DateTime @default(now()) @map("created_at")
  updated_at     DateTime @default(now())
  views          Int      @default(0)

  @@unique([platform, platformId])
  @@unique([platform, platformId], map: "AutoTrend_platform_platform_id_key")
  @@map("auto_trends")
}
