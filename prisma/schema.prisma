generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
  engineType    = "binary"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Automated trending products from TikTok/FB Ads
model AutoTrend {
  id             String   @id(map: "AutoTrend_pkey") @default(cuid())
  title          String
  slug           String   @unique(map: "AutoTrend_slug_key")
  content        String
  videoUrl       String   @map("video_url")
  thumbnailUrl   String?  @map("thumbnail_url")
  platform       String
  platformId     String   @map("platform_id")
  consensusScore Int      @default(0) @map("consensus_score")
  insights       Json?
  status         String   @default("draft")
  createdAt      DateTime @default(now()) @map("created_at")
  updated_at     DateTime @default(now())
  views          Int      @default(0)

  @@unique([platform, platformId])
  @@unique([platform, platformId], map: "AutoTrend_platform_platform_id_key")
  @@map("auto_trends")
}

model SavedProduct {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  productName  String   @map("product_name")
  platform     String   @default("General")
  price        Float    @default(0)
  profitMargin Float    @default(0) @map("profit_margin")
  competition  String   @default("Medium")
  aiScore      Int      @default(0) @map("ai_score")
  category     String   @default("General")
  notes        String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("saved_products")
}

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  content     String    @db.Text
  excerpt     String?   @db.Text
  coverImage  String?   @map("cover_image")
  status      String    @default("DRAFT")
  publishedAt DateTime? @map("published_at")
  authorId    String?   @map("author_id")
  viewCount   Int       @default(0) @map("view_count")
  tags        String[]  @default([])
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("blog_posts")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String?
  fullName      String?  @map("full_name")
  platform      String?
  monthlyOrders String?  @map("monthly_orders")
  emailVerified Boolean  @default(false) @map("email_verified")
  role          String   @default("user")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Profile {
  id                 String   @id
  subscriptionStatus String   @default("free") @map("subscription_status")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("profiles")
}

model SearchHistory {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  query       String
  queryType   String   @map("query_type")
  resultCount Int      @default(0) @map("result_count")
  results     Json
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("search_histories")
}

model EtsyProduct {
  id             String   @id @default(cuid())
  keyword        String
  listingId      String   @map("listing_id")
  title          String
  price          Float    @default(0)
  currency       String   @default("USD")
  favorites      Int      @default(0)
  views          Int      @default(0)
  reviews        Int      @default(0)
  shopName       String?  @map("shop_name")
  shopRating     Float    @default(0) @map("shop_rating")
  isBestSeller   Boolean  @default(false) @map("is_best_seller")
  isFreeShipping Boolean  @default(false) @map("is_free_shipping")
  thumbnail      String?
  imageUrl       String?  @map("image_url")
  tags           String[] @default([])
  url            String
  analysis       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("etsy_products")
}

model EtsyAnalysis {
  id               String   @id @default(cuid())
  productId        String   @map("product_id")
  trendScore       Int      @map("trend_score")
  saturationScore  Int      @map("saturation_score")
  opportunityScore Int      @map("opportunity_score")
  decision         String
  analysis         Json
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("etsy_analyses")
}

model EtsySupplier {
  id            String   @id @default(cuid())
  productId     String   @map("product_id")
  sourceType    String   @map("source_type")
  supplierName  String   @map("supplier_name")
  estimatedCost Float    @default(0) @map("estimated_cost")
  riskLevel     String   @default("Medium") @map("risk_level")
  notes         String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("etsy_suppliers")
}

model EtsyListing {
  id          String   @id @default(cuid())
  productId   String   @map("product_id")
  seoTitle    String   @map("seo_title")
  description String   @db.Text
  tags        String[] @default([])
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("etsy_listings")
}
